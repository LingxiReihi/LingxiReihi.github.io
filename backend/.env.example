# personal-web 后端环境变量模板：cp .env.example .env 后按注释修改。
# 完整说明与生产建议值见 docs/deployment.md §3-C。

# ── 基础 ──
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# 必填！生产用 openssl rand -hex 32 生成；改动会使所有登录态失效
JWT_SECRET=replace-me
MEDIA_ROOT=./data/media

# ── 管理员初始化（仅 app.cli seed 首次读取；改密码走后台界面）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── 站点地址（本地开发用默认；生产填 https://你的域名）──
SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── 登录态时长（可选，默认如下）──
# ACCESS_TOKEN_MINUTES=120
# REFRESH_TOKEN_DAYS=7

# ── 前端重建流水线 ──
# 仅裸机/systemd 部署填写脚本绝对路径（发布即自动重建）；Docker 部署留空，
# 改配下方 REBUILD_REQUEST_FILE（docs/deployment.md §4-D）
# REBUILD_SCRIPT=
# Docker 模式：后端把重建请求写入该文件（容器路径，位于共享卷 data/ 内），
# 宿主机 cron 跑 scripts/rebuild-watcher.sh 消费并拉起 builder 构建
# REBUILD_REQUEST_FILE=/app/data/.rebuild-request
# 多次发布合并窗口（秒），默认 10
# REBUILD_MERGE_SECONDS=10

# ── 百度 SEO ──
# 推送接口（形如 https://data.zz.baidu.com/urls?site=xxx&token=xxx），未配置时 URL 记入 pending_push
# BAIDU_PUSH_API=
# 推送总开关，拿到 token 后改 true
# SEO_PUSH_ENABLED=false
# 百度站点验证文件（后台 SEO 面板/平台给出的文件名与内容）
# BAIDU_VERIFY_NAME=
# BAIDU_VERIFY_CONTENT=

# ── 邮件通道（「忘记密码」发信，复用同服务器 personal-mail 容器）──
# 发信端点。线上容器同网段用默认内网地址即可；本地开发在容器网络外，改公网域名
# MAIL_API_URL=http://mail:8000/api/external/send
# 建议在后台「站点设置 → 邮件通道」里填（密文入库，优先于这里），此处仅作兜底
# MAIL_API_KEY=
# 测试收件人：非空时所有重置邮件改投该地址，线上留空
# MAIL_OVERRIDE_TO=
